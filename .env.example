# Hermes — example environment.
#
# COPY THIS FILE TO `.env` AND FILL IN WHAT YOU NEED. NEVER COMMIT `.env`.
#
#     cp .env.example .env && chmod 600 .env
#
# Three things to know before you start:
#
#   1. Everything here is OPTIONAL. A missing provider is recorded as "no
#      source available" — Hermes never invents data to fill a gap.
#   2. Nothing here enables sending. Not one variable in this file can make
#      Hermes contact anybody. First contact and auto-reply each require a
#      separate, named activation, and the global kill switch has to be
#      released by hand. See CLAUDE_SETUP.md.
#   3. Never paste another operator's credentials here. Every key, token,
#      cookie and account below must be YOURS.
#
# ---------------------------------------------------------------------------
# Identity of this instance (fill these first)
# ---------------------------------------------------------------------------
# The ICP profile this instance targets: the key of a file in config/icp/.
# UNSET = UNCONFIGURED, and that is the shipped default. A fresh instance has
# no ICP; you build yours during setup. `config/icp/example-icp.json` is a
# synthetic placeholder — it describes no real market and is not calibrated.
# OUTBOUND_ICP_PROFILE=my-icp

# The commercial-priority weights: the key of a file in
# config/commercial-intelligence/. Defaults to the shipped EXAMPLE profile,
# whose weights are flat and uncalibrated — it ranks nothing correctly until
# you calibrate it on your own observations.
# OUTBOUND_COMMERCIAL_PROFILE=my-profile

# The ONLY Gmail mailbox this instance may read. Required by
# `npm run r6b:gmail:auth`, which revokes the token if the account that
# consents on screen is not this one.
# OUTBOUND_GMAIL_ACCOUNT=you@example.com


# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
# Which database backend this process talks to: "postgres" or "pglite".
# Unset keeps the historical rule: postgres if OUTBOUND_DATABASE_URL is set,
# PGlite otherwise. Declaring it is preferred — a process that meant to reach
# Postgres then fails loudly instead of quietly opening a local file.
# OUTBOUND_DB_BACKEND=postgres

# PGlite (embedded, single-owner) data directory. Default: ./var/pgdata
# Transitional: kept for tests and for the pre-migration corpus.
OUTBOUND_DB_DIR=./var/pgdata

# Target runtime backend: the managed Postgres of the Hermes Supabase project.
# The SAME migrations in db/migrations run against it — no domain rewrite.
# Use the *session* connection (port 5432), not the transaction pooler (6543):
# the transaction pooler drops session state between statements, which breaks
# migrations and the data transfer. See CLAUDE_SETUP.md.
# Point this at a database DEDICATED to Hermes. Never share it with another
# application: the migrations own the schema.
# NEVER commit a real value — .env is gitignored, .env.example is not.
# OUTBOUND_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# TLS posture: disable | require | verify-full.
# Default: "disable" for a loopback host, "verify-full" for anything else —
# a managed database is reached over the public internet, so certificate
# verification is the default rather than something you must remember.
# OUTBOUND_DB_SSL=verify-full

# CA bundle used to verify the server certificate (libpq's `sslrootcert`).
# Supabase's connection pooler presents a chain signed by "Supabase Root 2021
# CA", which is not in any system trust store, so verify-full needs it pinned.
# Download it from the dashboard: Project Settings > Database > SSL Configuration.
# The file is a public certificate, not a secret — but keep it out of Git anyway.
# OUTBOUND_DB_SSL_ROOT_CERT=./var/supabase-ca.crt

# Connections held by THIS process. Several processes (CRM, Gmail watcher,
# workers) each open their own pool, so keep the sum under the provider's limit.
# OUTBOUND_DB_POOL_MAX=10

# Identifies the process in pg_stat_activity. Defaults to the entry-point name.
# OUTBOUND_DB_APP_NAME=hermes-crm

# Disposable Postgres for tests/postgresConcurrency.test.ts ONLY. Never the
# corpus database — the test truncates what it touches. Absent = tests skipped.
# OUTBOUND_TEST_DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5433/hermes_outbound_test

# ---------------------------------------------------------------------------
# LLM routing (see config/models.json for the per-task routing table)
# ---------------------------------------------------------------------------
# Provider used when a task's route says "codex": the locally installed,
# already-authenticated Codex CLI. No API key is read or stored by this app.
OUTBOUND_CODEX_BIN=codex
# Hard ceiling per LLM call, in milliseconds.
OUTBOUND_LLM_TIMEOUT_MS=180000

# Provider used when a task's route says "openai_compatible".
# OUTBOUND_OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OUTBOUND_OPENAI_API_KEY=
# OUTBOUND_OPENAI_DEFAULT_MODEL=

# Set to 1 to forbid every LLM call (deterministic stages still run).
OUTBOUND_LLM_DISABLED=0

# R5.1 — retour arrière vers le routage de modèles de R5, en une variable.
#
# Vide (défaut) : config/models.json, le routage R5.1 issu du benchmark
#                 (terra-medium sur research/angle/message, délais bornés).
# Renseigné     : le fichier indiqué remplace entièrement le routage.
#
#   OUTBOUND_MODELS_CONFIG=config/models.r5.json
#
# Un chemin absent est une erreur franche, jamais un repli silencieux : croire
# qu'on tourne en R5 alors qu'on tourne en R5.1 serait pire que l'échec.
OUTBOUND_MODELS_CONFIG=

# ---------------------------------------------------------------------------
# Discovery / enrichment providers
# ---------------------------------------------------------------------------
# recherche-entreprises.api.gouv.fr (official French company registry, no key).
OUTBOUND_SIRENE_BASE_URL=https://recherche-entreprises.api.gouv.fr
# OpenStreetMap Overpass (no key).
OUTBOUND_OVERPASS_URL=https://overpass-api.de/api/interpreter
# Contact address advertised in the crawler User-Agent (good scraping citizenship).
OUTBOUND_CRAWLER_CONTACT=contact@hermes.agency

# Web search unlocks website + social discovery for prospects that have no
# website recorded in an open registry. Leave provider=none to keep it off.
# Supported: none | webintel | serper | brave | google_cse
#
# `webintel` is the self-hosted option and the only one that costs nothing: a
# dedicated SearXNG instance plus our own crawler on le serveur. See
# la documentation d’installation for how to deploy it.
OUTBOUND_SEARCH_PROVIDER=none
# OUTBOUND_SERPER_API_KEY=
# OUTBOUND_GOOGLE_CSE_KEY=
# OUTBOUND_GOOGLE_CSE_CX=

# --- Brave Search API (R4) — LIRE la documentation d’installation AVANT D'ACTIVER ---
#
# Nom actuel de la variable. `OUTBOUND_BRAVE_API_KEY` reste accepté pour ne pas
# casser une configuration existante ; c'est ce nom-ci que le code annonce.
# OUTBOUND_BRAVE_SEARCH_KEY=
#
# Deux choses à savoir avant de mettre une clé ici.
#
# 1. IL N'Y A PLUS DE PALIER GRATUIT. Brave l'a supprimé en février 2026 : les
#    2 000 requêtes mensuelles offertes sont devenues 5 $ de crédit mensuel
#    (~1 000 requêtes à 5 $ les 1 000), après quoi la carte enregistrée est
#    débitée. Les plafonds ci-dessous sont donc le seul rempart réel.
#
# 2. LES RÉSULTATS NE PEUVENT PAS ÊTRE STOCKÉS. Les conditions interdisent de
#    constituer une base de résultats de recherche. Le code s'y conforme par
#    construction — `noCache: true`, aucune colonne pour un titre ou un extrait,
#    et un garde-fou qui lève sur le chemin d'écriture. Ne pas contourner.
#
# Plafonds de dépense. Trois portées : le run est un mur anti-boucle en mémoire,
# le jour et le mois se lisent en base et survivent donc à un redémarrage. Le
# plafond mensuel est calé SOUS le crédit offert pour que le premier euro dépensé
# demande une modification délibérée de ce fichier.
OUTBOUND_SEARCH_RUN_LIMIT=200
OUTBOUND_SEARCH_DAILY_LIMIT=400
OUTBOUND_SEARCH_MONTHLY_LIMIT=900

# ---------------------------------------------------------------------------
# Google Places — rail commercial (R2, révisé R2.1)
# ---------------------------------------------------------------------------
# LIRE la documentation d’installation AVANT D'ACTIVER.
#
#   1. Conservation : QUE le `place_id` (illimitée) et les coordonnées
#      (30 jours). Nom, adresse, téléphone, site, note : aucune permission de
#      cache. Places sert de pointeur ; ce qui est stocké vient du registre
#      officiel ou du site de l'entreprise. (R2.1 ne demande même plus les
#      coordonnées — voir §4 du document.)
#   2. R2 signalait la clause §3.2.3(d)(iii) des conditions STANDARD
#      (« listings or directory service »). Elle N'EXISTE PAS dans les
#      conditions EEE : Google l'a retirée le 8 juillet 2025. À la place, l'EEE
#      impose une LISTE BLANCHE FERMÉE de neuf usages permis (EEA SST §15.2),
#      et le nôtre n'y figure pas de façon certaine. C'est une décision qui
#      appartient à un opérateur, pas au code — et probablement une question à poser
#      au support Google avant d'engager quoi que ce soit.
#
# Projet Google Cloud DÉDIÉ, API « Places API (New) » seule, clé serveur
# restreinte à cette API. Ne jamais réutiliser une clé d'AdSpot ou de un projet isole.
GOOGLE_PLACES_ENABLED=0
# OUTBOUND_GOOGLE_PLACES_KEY=

# Régime applicable. 1 = conditions EEE (défaut, et c'est le cas de Hermes :
# facturation française). Le mettre à 0 déclare une facturation hors EEE et
# rebascule sous les conditions standard — où la clause « directory service »
# s'applique de nouveau. Ne pas y toucher sans raison écrite.
GOOGLE_PLACES_EEA_BILLING=1

# L'usage permis sous lequel nous opérons, parmi les NEUF de la liste fermée :
#   address_autocomplete | own_locations | sales_opportunities | tasks_and_notes
#   real_estate_context  | financial_transaction | games | social_tagging
#   smart_home
# VIDE PAR DÉFAUT, VOLONTAIREMENT. Sans valeur, tout appel portant autre chose
# que `place_id` / lat / lng est refusé AVANT d'être émis. Le seul candidat
# plausible pour Hermes est `sales_opportunities` — « visualize and manage
# Places content related to a sales team's customers or opportunities » — dont
# la lecture appliquée à de la prospection sortante n'est PAS établie.
# Renseigner cette variable, c'est prendre la décision. Elle est tracée.
# GOOGLE_PLACES_EEA_PERMITTED_USE=

# Garde-fou applicatif, indépendant de Google. Le free tier borne la gratuité,
# pas le nombre d'appels : ces limites-là bornent les appels. Un dépassement est
# un arrêt propre, jamais une nouvelle tentative.
# Appels facturables par run (le plafond « argent ») :
GOOGLE_PLACES_RUN_LIMIT=400
# Appels totaux par run, gratuits inclus (le plafond « boucle folle ») :
GOOGLE_PLACES_RUN_CALL_CEILING=2000
GOOGLE_PLACES_DAILY_LIMIT=1000
# Volontairement SOUS les plafonds mensuels sans frais documentés par Google
# (Essentials 10 000, Enterprise 1 000) : les dépasser doit demander un geste.
GOOGLE_PLACES_MONTHLY_DISCOVERY_LIMIT=8000
GOOGLE_PLACES_MONTHLY_DETAILS_LIMIT=800

# ---------------------------------------------------------------------------
# Safety
# ---------------------------------------------------------------------------
# V1 is review-only. This flag exists so that sending code, when it lands,
# cannot run by accident. Do not change it in V1.
OUTBOUND_ALLOW_SENDING=0

# ---------------------------------------------------------------------------
# R6B-C.2B — envoi email LIVE, un seul manifeste (voir r6bLiveDispatch.ts)
# ---------------------------------------------------------------------------
# Rien ici n'autorise à lui seul un envoi. Un envoi réel exige QUATRE
# conditions simultanées : `--live`, OUTBOUND_ALLOW_SENDING=1,
# OUTBOUND_LIVE_MANIFEST_ID égal au manifeste armé EN DUR dans le code, et un
# `--manifest-id` identique sur la ligne de commande. Un `.env` complet ne
# suffit pas, et ne peut pas désigner un autre manifeste que celui du code.
#
# Identifiant du manifeste autorisé. Toute autre valeur bloque avant le réseau.
# OUTBOUND_LIVE_MANIFEST_ID=

# Clé d'API du provider d'envoi. Secret : jamais commitée, jamais journalisée.
# OUTBOUND_EMAIL_TIMEOUT_MS=20000
# RESEND_API_KEY=

# Identité d'expéditeur, telle qu'envoyée au provider. Aucune valeur par
# défaut : absente ou mal formée, l'envoi est refusé plutôt que deviné. Le
# domaine doit être vérifié (DKIM/SPF) chez le provider.
# OUTBOUND_EMAIL_FROM=Prénom <expediteur@votre-domaine-verifie.tld>
# OUTBOUND_EMAIL_REPLY_TO=reponse@votre-domaine.tld

# ---------------------------------------------------------------------------
# R6B-D1 — lecture des réponses (Gmail, LECTURE SEULE)
# ---------------------------------------------------------------------------
# `npm run r6b:inbound:poll` lit la boîte de réponse pour savoir si un prospect
# a répondu. Il ne peut rien envoyer et rien modifier dans Gmail : le contrat
# du fournisseur ne nomme aucune opération d'écriture (pas d'envoi, mais pas
# non plus « marquer comme lu », archiver, étiqueter ou supprimer).
#
# Portée OAuth attendue, et LA SEULE acceptée :
#   https://www.googleapis.com/auth/gmail.readonly
#
# `gmail.metadata` serait plus étroite mais ne convient pas : la documentation
# Gmail est explicite — elle ne rend pas le corps des messages, et le paramètre
# `q` de users.messages.list « cannot be used with the gmail.metadata scope »,
# c'est-à-dire précisément le mécanisme qui borne la lecture aux échanges de
# l'outbound plutôt qu'à toute la boîte.
#
# Un jeton portant une portée d'ÉCRITURE (gmail.modify, gmail.send,
# https://mail.google.com/ …) est REFUSÉ par le code, pas seulement inutilisé.
#
# Sans ces quatre variables, la commande s'arrête avant toute connexion et dit
# lesquelles manquent — jamais leur valeur. Toutes sont des secrets sauf la
# dernière : jamais commitées, jamais journalisées.
# GMAIL_OAUTH_CLIENT_ID=
# GMAIL_OAUTH_CLIENT_SECRET=
# GMAIL_OAUTH_REFRESH_TOKEN=
# Adresse de la boîte lue — celle qui sert de reply-to à l'outbound.
# GMAIL_INBOX_ADDRESS=reponse@votre-domaine.tld

# ---------------------------------------------------------------------------
# Hermes Web Intelligence (self-hosted worker on le serveur)
# ---------------------------------------------------------------------------
# Private HTTP API reached over Tailscale. Both values are written by
# deploy/selfhost/install.sh into /opt/selfhost/hermes-webintel/webintel.env on
# the server; copy the token from there. It is a secret: never commit it.
# OUTBOUND_WEBINTEL_URL=http://100.x.y.z:8099
# OUTBOUND_WEBINTEL_TOKEN=
# Hard ceiling per call to the worker, in milliseconds.
OUTBOUND_WEBINTEL_TIMEOUT_MS=180000

# A `probable` resolution is a good guess, not an observation. Left at 0, such a
# domain is recorded as a candidate and never written to `prospects.website_url`
# — because once written, a guess stops looking like one. Set to 1 only when a
# human has decided that a wider net is worth the risk of a wrong domain.
OUTBOUND_WEBINTEL_ATTACH_PROBABLE=0

# ---------------------------------------------------------------------------
# R3 — rail web ouvert (gratuit, sans clé)
# ---------------------------------------------------------------------------
# Index d'URL public de Common Crawl. Gratuit, sans compte. Sert à corroborer
# qu'un domaine candidat a déjà servi des pages — jamais à rejeter un candidat :
# l'index échantillonne le web, il ne l'énumère pas.
# Le serveur est explicitement « heavily rate limited » : concurrence 1 et
# 1,5 s d'espacement sont câblés dans openWebSchedulerLimits().
OUTBOUND_COMMON_CRAWL_ENABLED=1
OUTBOUND_COMMON_CRAWL_URL=https://index.commoncrawl.org
# Nombre d'index mensuels interrogés par domaine avant d'abandonner.
OUTBOUND_COMMON_CRAWL_INDEX_DEPTH=2
OUTBOUND_COMMON_CRAWL_TIMEOUT_MS=25000

# ---------------------------------------------------------------------------
# R3 — Meta (Facebook Pages, Instagram Business Discovery)
# ---------------------------------------------------------------------------
# INTERDIT : réutiliser l'application Meta d'un autre projet (un projet isole,
# moderation, client). Seule une application DÉDIÉE à Hermes peut être
# renseignée ici. Voir CLAUDE.md §4 et la documentation d’installation.
#
# Sans ces valeurs, les deux rails sont `not_configured` et n'émettent aucune
# requête. C'est l'état actuel et il est correct.
# OUTBOUND_META_APP_ID=
# OUTBOUND_META_ACCESS_TOKEN=
# Notre propre compte Instagram professionnel, exigé par Business Discovery.
# Ce rail n'a jamais découvert de compte : il enrichit un username déjà connu.
# OUTBOUND_META_IG_USER_ID=
OUTBOUND_META_GRAPH_VERSION=v26.0

# Déclaratifs, et volontairement séparés du jeton : disposer d'un jeton ne vaut
# pas disposer d'une permission. Tant que ces drapeaux sont à 0, l'adaptateur
# refuse d'appeler — tenter l'endpoint « pour voir » serait tester une
# restriction. À ne passer à 1 qu'une fois l'App Review réellement accordée.
OUTBOUND_META_PPCA_GRANTED=0
OUTBOUND_META_IPCA_GRANTED=0

# ---------------------------------------------------------------------------
# CRM — R6B-D2.1 (projection des réponses vers un pipeline commercial)
# ---------------------------------------------------------------------------
#
# Ces trois variables ne suffisent PAS à autoriser une écriture. La projection
# exige en plus qu'une ligne `r6b_crm_destinations` en statut CONFIRMED porte
# exactement le même `location_id`, avec le nom de l'humain qui l'a confirmée
# (`npm run r6b:crm:verify -- --confirm --as "<nom>"`). Une variable copiée
# d'ailleurs ou exportée par erreur produit donc un `BLOCKED_CONFIG` visible,
# jamais une écriture chez un tiers.
#
# INTERDIT : réutiliser le sous-compte CRM d'un autre projet. Seul un
# sous-compte appartenant à Hermes, ou explicitement approuvé, peut être
# renseigné ici. Voir CLAUDE.md §4 et la documentation d’installation.
#
# Sans ces valeurs, la projection est `SKIPPED_NOT_CONFIGURED` : la charge utile
# est construite, persistée et auditable, mais rien ne part. C'est l'état actuel
# et il est correct.
# OUTBOUND_CRM_PROVIDER=gohighlevel
# OUTBOUND_CRM_LOCATION_ID=
# OUTBOUND_CRM_API_KEY=

# ---------------------------------------------------------------------------
# R7.8B — un projet isole Targeted Page Presence (service externe, API privée)
# ---------------------------------------------------------------------------
# API interne d'un projet isole, jointe sur le réseau Tailscale du poste qui exécute la
# commande — jamais une IP en dur dans le code (src/lib/paid/adRadarClient.ts).
# Sans ces deux valeurs, `npm run r7:meta-page-presence` s'arrête avant tout
# appel réseau et le dit : BLOCKED_CONFIG, jamais un verdict simulé.
# ADRADAR_API_BASE_URL=http://100.x.y.z:3050
# Jeton porteur, jamais journalisé, jamais commité.
# ADRADAR_HERMES_API_KEY=

# ---------------------------------------------------------------------------
# CONVERSATION-R1.1 — le cerveau conversationnel en OMBRE
# ---------------------------------------------------------------------------
# À 1, `npm run r6b:replies:process` fait tourner le cerveau conversationnel À
# CÔTÉ du chemin canonique et journalise la comparaison : longueur, nombre de
# questions, verdict de naturalité, maturité pour un appel.
#
# Ce que ce drapeau n'ouvre PAS : aucune réponse automatique, aucun envoi,
# aucun brouillon supplémentaire en base, aucune écriture CRM. Le brouillon
# canonique reste le seul persisté et le seul qu'un humain voit. Le module
# d'ombre n'importe aucun provider d'envoi — un test le vérifie fichier par
# fichier.
#
# À 0 (le défaut), le module n'est pas appelé du tout.
OUTBOUND_CONVERSATION_SHADOW_ENABLED=0
